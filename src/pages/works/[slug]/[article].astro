---
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import Shell from '../../../layouts/Shell.astro';
import { getCollectionArticles } from '../../../lib/collection-articles';
import { getWorks } from '../../../lib/works';

export function getStaticPaths() {
  return getWorks().filter(work => work.collection).flatMap(work => (
    getCollectionArticles(work.slug).map(article => ({
      params: { slug: work.slug, article: article.slug },
      props: { work, article },
    }))
  ));
}

const { work, article } = Astro.props;
const { Content } = article;
---

<Shell title={article.title} description={article.summary} assetBase={article.assetBase}>
  <article class="paper-page reading-page">
    <a href={work.href} class="back"><ArrowLeft size={14} />{work.title}</a>
    <header class="article-head">
      <h1>{article.title}</h1>
      <div class="byline">
        <span>{article.author}</span>
        <time datetime={article.date}>{article.date}</time>
        {article.spoiler && <span class="spoiler">{article.spoiler}</span>}
      </div>
    </header>
    <div class="prose article-body"><Content /></div>
    <footer class="article-footer">
      <a href={work.href} class="back"><ArrowLeft size={14} />返回文章列表</a>
      {article.source && <a href={article.source} class="back">微信原文<ArrowUpRight size={14} /></a>}
    </footer>
  </article>
</Shell>

<style>
  .article-head { margin-bottom: 29px; padding-bottom: 18px; border-bottom: 1px solid var(--line); }
  .article-head h1 { margin-bottom: 13px; overflow-wrap: anywhere; }
  .byline { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 15px; color: var(--muted); font-size: 14px; }
  .byline time { font-family: var(--mono); font-size: 13px; }
  .spoiler { padding: 3px 7px; border-radius: 3px; color: #83452f; background: #f3e8d8; font-size: 12px; }
  .article-body { font-size: 17px; }
  .article-body :global(p) { margin: 0 0 1.15em; }
  .article-body :global(h2) { color: var(--green); }
  .article-body :global(figure) { margin: 28px 0; }
  .article-body :global(img) { display: block; height: auto; margin-inline: auto; border-radius: 4px; }
  .article-body :global(figcaption) { margin-top: 8px; color: var(--muted); font-size: 13px; text-align: center; }
  .article-body :global(blockquote) { margin: 24px 0; padding: 1em 1em 0; border-left: 3px solid #a5b39e; background: #f0f1e8; overflow: hidden; }
  .article-footer { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 14px; margin-top: 33px; padding-top: 16px; border-top: 1px solid var(--line); }
  @media (max-width: 640px) {
    .reading-page { margin-top: 30px; }
    .article-head h1 { font-size: 29px; }
    .article-body { font-size: 16px; }
  }
</style>
