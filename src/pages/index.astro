---
import Shell from '../layouts/Shell.astro';
import { getWorks } from '../lib/works';
import { ArrowDown, ArrowUpRight, Feather, Gamepad2, Grid2X2, Hammer, Layers3, NotebookPen, UserRound } from '@lucide/astro';
const icons = new Map([['游戏', Gamepad2], ['工具', Hammer], ['手记', NotebookPen], ['学术', NotebookPen]]);
const priority = (type: string) => [...icons.keys()].indexOf(type) < 0 ? 99 : [...icons.keys()].indexOf(type);
const works = (await getWorks()).sort((a,b) => priority(a.type) - priority(b.type) || a.title.localeCompare(b.title, 'zh-CN'));
const types = [...new Set(works.map(work => work.type))];
const total = String(works.length).padStart(2, '0');
---
<Shell>
  <section class="hero" aria-labelledby="site-title">
    <img class="panorama" src="/images/landscape.webp" alt="" fetchpriority="high" />
    <div class="wrap hero-inner">
      <div class="hero-copy">
        <div class="eyebrow"><i aria-hidden="true"></i> SHANLINGLU COLLECTIVE</div>
        <div class="mast"><h1 id="site-title">山泠庐</h1><span class="seal" aria-hidden="true"><span>山泠</span><span>庐印</span></span></div>
        <p>一个宿舍的创意试验场。<br />我们用代码做游戏、造工具，也记录随手探索的想法。</p>
        <a class="browse" href="#works">浏览作品 <ArrowDown size={16} stroke-width={1.8} /></a>
      </div>
    </div>
  </section>
  <section id="works" class="wrap collection" aria-labelledby="collection-title">
    <header class="collection-head">
      <div class="collection-name"><span class="section-rule"></span><h2 id="collection-title">作品集</h2><span class="eng">Collection</span></div>
      <div class="filters" aria-label="按类型筛选作品">
        <button type="button" data-all aria-pressed="true"><Grid2X2 size={14} />全部 <span>{total}</span></button>
        {types.map(type => {
          const Icon = icons.get(type) ?? Layers3;
          return <button type="button" data-category={type} aria-pressed="false"><Icon size={15} />{type}</button>;
        })}
      </div>
    </header>
    <div id="work-grid" class="work-grid">
      {works.map(work => {
        const Icon = icons.get(work.type) ?? Feather;
        return <article class="work" data-type={work.type}>
          <a class="cover-link" href={work.href} aria-label={work.title}>
            {work.coverUrl ? <img class="work-cover" src={work.coverUrl} alt="" /> : <div class="fallback-cover"><Icon size={64} stroke-width={1} /></div>}
            <span class:list={['tag', { blue: work.type === '手记' || work.type === '学术' }]}><Icon size={13} />{work.type}</span>
          </a>
          <div class="work-copy">
            <h3><a href={work.href}>{work.title}</a></h3>
            <p>{work.summary}</p>
            <div class="work-meta">
              <span class="author"><UserRound size={13} />{work.author}</span>
              <div class="work-links">
                {work.source && <a class="source" href={work.source}>源码</a>}
                <a class="open-work" href={work.href}>{work.action}<ArrowUpRight size={14} /></a>
              </div>
            </div>
          </div>
        </article>;
      })}
    </div>
    <p id="filter-status" aria-live="polite" class="sr-only"></p>
  </section>
</Shell>
<script>
  const filters = document.querySelectorAll<HTMLButtonElement>('.filters button');
  const cards = document.querySelectorAll<HTMLElement>('#work-grid [data-type]');
  for (const button of filters) {
    button.addEventListener('click', () => {
      for (const other of filters) other.setAttribute('aria-pressed', String(other === button));
      let count = 0;
      for (const card of cards) {
        card.hidden = Boolean(button.dataset.category && button.dataset.category !== card.dataset.type);
        if (!card.hidden) count++;
      }
      const status = document.querySelector('#filter-status');
      if (status) status.textContent = (button.dataset.category || '全部') + '，共 ' + count + ' 件作品';
    });
  }
</script>
<style>
  .hero { position: relative; isolation: isolate; overflow: hidden; border-bottom: 1px solid #b9c1af; background: #f7f5eb; }
  .panorama { position: absolute; z-index: -1; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 68% center; }
  .hero-inner { min-height: 363px; display: flex; align-items: center; position: relative; }
  .hero-copy { padding: 38px 0 37px; }
  .eyebrow { display: flex; align-items: center; gap: 10px; color: #425849; font: 600 12px/1.5 var(--mono); }
  .eyebrow i { display: inline-block; width: 23px; height: 2px; background: var(--red); }
  .mast { display: flex; align-items: center; gap: 15px; margin: 12px 0 14px; }
  h1 { font: 900 87px/1.12 var(--serif); margin: 0; color: #1c352a; }
  .seal { display: flex; flex-direction: column; align-items: center; justify-content: center; color: #ae4835; border: 2px solid currentColor; outline: 1px solid currentColor; outline-offset: -5px; border-radius: 3px 2px 4px 2px; transform: rotate(-5deg); width: 35px; height: 38px; font: 800 13px/1.02 var(--serif); margin-top: 17px; }
  .hero-copy p { font-size: 15px; line-height: 1.85; color: #34453a; margin: 0 0 23px; }
  .browse { display: inline-flex; gap: 12px; align-items: center; padding: 10px 17px; background: var(--green); border: 1px solid var(--green); color: white; border-radius: 3px; font-size: 14px; font-weight: 600; }
  .browse:hover { background: #34654d; }
  .collection { scroll-margin-top: 20px; padding-top: 32px; }
  .collection-head, .collection-name, .filters, .filters button, .tag, .work-meta, .open-work, .author { display: flex; align-items: center; }
  .collection-head { justify-content: space-between; gap: 20px; margin-bottom: 21px; }
  .collection-name { gap: 12px; }
  .section-rule { display:block; height: 23px; width: 4px; background: var(--red); }
  h2 { margin: 0; color: #213a2e; font: 800 33px/1.2 var(--serif); }
  .eng { align-self: end; color: #798172; font: italic 16px/1.6 Georgia, serif; }
  .filters { gap: 5px; flex-wrap: wrap; }
  .filters button { gap: 6px; border: 1px solid transparent; background: transparent; padding: 6px 10px; min-height: 32px; color: #5f695e; border-radius: 3px; font-size: 13px; }
  .filters button:hover { background: #eff0e8; }
  .filters button[aria-pressed=true] { color: #244c3c; background: #e4eadc; border-color: #c7d3be; font-weight: 650; }
  .filters button span { font: 10px var(--mono); color: #556d52; }
  .work-grid { display: grid; grid-template-columns: repeat(2, minmax(0,1fr)); align-items: stretch; gap: 24px; }
  .work { display: flex; flex-direction: column; min-width: 0; background: #fffef8; border: 1px solid #d6d9c9; border-radius: 5px; overflow: hidden; }
  .work[hidden] { display: none; }
  .cover-link { position: relative; display: block; overflow: hidden; border-bottom: 1px solid #d8dbcb; background: #e2e8d7; }
  .work-cover, .fallback-cover { width: 100%; aspect-ratio: 2.25; object-fit: cover; }
  .fallback-cover { display: grid; place-items: center; color: #597960; }
  .tag { position: absolute; top: 13px; left: 13px; gap: 5px; background: #fcfff0ed; color: #244f3e; border: 1px solid #b8c7a7; border-radius: 3px; font-size: 11px; line-height: 1; padding: 6px 8px; font-weight: 650; }
  .tag.blue { background: #f0f5f4ee; color: #395b6c; border-color: #c1cfcc; }
  .work-copy { padding: 17px 19px 14px; display: flex; flex-direction: column; flex: 1; }
  h3 { margin: 0; font: 800 25px/1.45 var(--serif); color: #233a2c; }
  h3 a:hover, .open-work:hover { text-decoration: underline; text-underline-offset: 3px; }
  .work-copy p { margin: 5px 0 14px; font-size: 14px; line-height: 1.7; color: #596157; }
  .work-meta { justify-content: space-between; margin-top: auto; padding-top: 12px; border-top: 1px solid #e4e5da; gap: 12px; }
  .author, .open-work { gap: 5px; font-size: 12px; }
  .author { color: #667061; }
  .work-links { display: flex; align-items: center; gap: 11px; }
  .source { font-size: 12px; color: var(--muted); }
  .source:hover { text-decoration: underline; }
  .open-work { color: var(--green); font-weight: 700; }
  .sr-only { position: absolute; height: 1px; width: 1px; margin: -1px; overflow: hidden; clip-path: inset(50%); }
  @media(min-width: 1700px) { .hero-inner { min-height: 405px; } }
  @media(max-width: 900px) { .hero-inner { min-height: 327px; } h1 { font-size: 74px; } .work-grid {gap: 18px;} .hero-copy p { max-width: 370px; } }
  @media(max-width: 640px) {
    .hero-inner { min-height: 300px; }
    .hero-copy { padding: 26px 0 27px; }
    .panorama { object-position: 43% bottom; opacity: .65; }
    h1 { font-size: 60px; } .mast { gap: 10px; margin: 12px 0; }
    .seal { width: 26px; height: 30px; font-size: 10px; margin-top: 9px; }
    .eyebrow { font-size: 10px; }
    .hero-copy p { font-size: 13px; max-width: 243px; line-height: 1.7; margin-bottom: 18px; }
    .browse { padding: 8px 13px; font-size: 13px; }
    .collection { padding-top: 23px; }
    .collection-head { gap: 12px; flex-wrap: wrap; margin-bottom: 15px; }
    .collection-name { gap: 8px; } h2 { font-size: 27px; } .eng { font-size: 13px; }
    .filters { gap: 0; } .filters button { font-size: 12px; padding: 5px 6px; }
    .work-grid { grid-template-columns: 1fr; }
    .work-copy { padding: 13px 15px; }
    h3 { font-size: 23px; }
  }
  @media(max-width: 370px) { .eng { display:none; } }
</style>
