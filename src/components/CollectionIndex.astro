---
import { ArrowLeft, ArrowUpRight } from '@lucide/astro';
import Shell from '../layouts/Shell.astro';
import { getCollectionArticles } from '../lib/collection-articles';
import type { getWorks } from '../lib/works';

interface Props { work: ReturnType<typeof getWorks>[number] }
const { work } = Astro.props;
const articles = getCollectionArticles(work.slug);
---

<Shell title={work.title} description={work.summary}>
  <section class="paper-page archive" aria-labelledby="collection-title">
    <a href="/#works" class="back"><ArrowLeft size={14} />返回作品集</a>
    <header class="archive-head">
      <h1 id="collection-title">{work.title}</h1>
      <p>{work.summary}</p>
    </header>
    <ol class="article-list" aria-label="文章列表">
      {articles.map(article => (
        <li>
          <a class="article-link" href={article.href}>
            {article.coverUrl && <img src={article.coverUrl} alt="" loading="lazy" decoding="async" />}
            <div class="article-copy">
              <p class="article-meta"><time datetime={article.date}>{article.date}</time>{article.spoiler && <span>{article.spoiler}</span>}</p>
              <h2>{article.title}</h2>
              <p class="article-summary">{article.summary}</p>
            </div>
            <ArrowUpRight class="article-arrow" size={18} />
          </a>
        </li>
      ))}
    </ol>
    {articles.length === 0 && <p class="empty">这个栏目暂时没有文章。</p>}
  </section>
</Shell>

<style>
  .archive { max-width: 940px; }
  .archive-head { margin-bottom: 34px; }
  .archive-head h1 { margin-bottom: 10px; }
  .archive-head p { margin: 0; color: var(--muted); line-height: 1.7; }
  .article-list { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
  .article-list li { border-bottom: 1px solid var(--line); }
  .article-link { display: flex; align-items: center; gap: 22px; padding: 19px 0; }
  .article-link img { width: 27%; max-width: 230px; aspect-ratio: 2.25; object-fit: cover; border-radius: 4px; background: #e5e9dd; }
  .article-copy { flex: 1; min-width: 0; }
  .article-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 5px 12px; margin: 0 0 5px; color: var(--muted); font-size: 12px; }
  .article-meta time { font-family: var(--mono); }
  .article-meta span { color: #8a4b35; }
  .article-copy h2 { margin: 0; color: var(--green); font: 750 24px/1.35 var(--serif); overflow-wrap: anywhere; }
  .article-link:hover h2, .article-link:focus-visible h2 { text-decoration: underline; text-underline-offset: 4px; }
  .article-summary { margin: 6px 0 0; color: var(--muted); font-size: 14px; line-height: 1.65; overflow-wrap: anywhere; }
  .article-arrow { flex: none; color: var(--green); }
  .empty { color: var(--muted); }
  @media (max-width: 640px) {
    .archive { margin-top: 30px; }
    .archive-head { margin-bottom: 23px; }
    .archive-head h1 { font-size: clamp(25px, 7.5vw, 34px); }
    .article-link { align-items: flex-start; gap: 12px; padding: 15px 0; }
    .article-copy h2 { font-size: 18px; }
    .article-summary { font-size: 13px; }
    .article-link img { width: 28%; aspect-ratio: 2; margin-top: 2px; }
    .article-arrow { display: none; }
  }
</style>
